{
  "name": "@quran-project/shared-ts",
  "private": true,
  "version": "0.0.0",
  "description": "Shared TypeScript utilities",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "codegen.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "codegen": "graphql-codegen --config codegen.ts && pnpm --filter @quran-project/eslint-config exec prettier --write ../shared-ts/src/graphql/types.generated.ts",
    "format:check": "pnpm --filter @quran-project/eslint-config exec prettier --check --ignore-path ../shared-ts/.prettierignore ../shared-ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@quran-project/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "graphql": "^17.1.0"
  }
}
