{
  "extends": "../ts-config/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "codegen.ts"]
}
