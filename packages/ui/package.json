{
  "name": "@quran-project/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Shared UI components package placeholder",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./theme/tokens": {
      "types": "./src/theme/tokens.ts",
      "default": "./src/theme/tokens.ts"
    },
    "./theme/recipes": {
      "types": "./src/theme/recipes/index.ts",
      "default": "./src/theme/recipes/index.ts"
    },
    "./theme/global-css": {
      "types": "./src/theme/global-css.ts",
      "default": "./src/theme/global-css.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "pnpm --filter @quran-project/eslint-config exec prettier --check --ignore-path ../ui/.prettierignore ../ui",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quran-project/shared-ts": "workspace:*",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@pandacss/types": "^2.5.0",
    "@quran-project/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
