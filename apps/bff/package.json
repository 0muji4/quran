{
  "name": "@quran-project/bff",
  "private": true,
  "version": "0.0.0",
  "description": "GraphQL and REST BFF placeholder",
  "main": "dist/server/server.js",
  "types": "src/server/server.ts",
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "dev:local": "tsx --env-file=.env src/server/server.ts",
    "build": "tsc -b",
    "start": "node dist/server/server.js",
    "format:check": "pnpm --filter @quran-project/eslint-config exec prettier --check --ignore-path ../../apps/bff/.prettierignore ../../apps/bff",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@graphql-tools/schema": "^10.1.5",
    "@grpc/grpc-js": "^1.14.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-winston": "^0.62.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@quran-project/shared-ts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.1",
    "graphql": "^16.15.0",
    "graphql-helix": "^1.13.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@quran-project/eslint-config": "workspace:*",
    "@quran-project/ts-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "supertest": "^7.3.1",
    "ts-proto": "^2.18.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
