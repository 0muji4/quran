{
  "name": "@quran-project/bff",
  "private": true,
  "version": "0.0.0",
  "description": "GraphQL and REST BFF placeholder",
  "main": "dist/server/server.js",
  "types": "src/server/server.ts",
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "dev:local": "tsx --env-file=.env src/server/server.ts",
    "build": "tsc -b",
    "start": "node dist/server/server.js",
    "format:check": "pnpm --filter @quran-project/eslint-config exec prettier --check --ignore-path ../../apps/bff/.prettierignore ../../apps/bff",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.12",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.51.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.51.1",
    "@opentelemetry/instrumentation-winston": "^0.53.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-metrics": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.51.1",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@quran-project/shared-ts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "graphql-helix": "^1.13.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "pg": "^8.13.1",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.3.0",
    "@opentelemetry/sdk-trace-node": "^2.3.0",
    "@quran-project/eslint-config": "workspace:*",
    "@quran-project/ts-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minio": "^7.1.1",
    "@types/node": "^25.9.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.11.1",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
