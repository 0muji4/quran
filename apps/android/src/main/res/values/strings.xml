<?xml version="1.0" encoding="utf-8"?>
<!--
  English source-of-truth strings. The values-ar/strings.xml mirror
  ships with the same keys; native Arabic translations are deferred
  per ADR 0009 (2026-05-09 update).

  Key prefix conventions follow the iOS `Localizable.strings` shape:
    error_<case>_title / error_<case>_recovery — one pair per AppError
    library_*, practice_*, result_*, history_* — feature-scoped UI
-->
<resources>
    <string name="app_name">Tilawah</string>

    <!-- Errors -->
    <string name="error_network_title">No connection</string>
    <string name="error_network_recovery">Check your internet and try again.</string>
    <string name="error_backend_unavailable_title">Server unavailable</string>
    <string name="error_backend_unavailable_recovery">The recitation service is temporarily unavailable. Please try again in a moment.</string>
    <string name="error_audio_permission_denied_title">Microphone access required</string>
    <string name="error_audio_permission_denied_recovery">Enable microphone access in Settings to record your recitation.</string>
    <string name="error_audio_recording_failed_title">Recording failed</string>
    <string name="error_audio_recording_failed_recovery">Something interrupted the recording. Try again.</string>
    <string name="error_audio_playback_failed_title">Playback failed</string>
    <string name="error_audio_playback_failed_recovery">The audio could not be played. Try again.</string>
    <string name="error_reference_unavailable_title">Reference unavailable</string>
    <string name="error_reference_unavailable_recovery">Teacher recitation for this ayah isn\'t ready yet. You can still record on your own.</string>
    <string name="error_scoring_timeout_title">Scoring took too long</string>
    <string name="error_scoring_timeout_recovery">The scoring service is busy. Try again in a moment.</string>
    <string name="error_storage_unavailable_title">Storage unavailable</string>
    <string name="error_storage_unavailable_recovery">Your practice history could not be saved. Free up space and try again.</string>

    <!-- Library tab -->
    <string name="library_eyebrow">Choose a surah to recite</string>
    <string name="library_title">Surah library</string>
    <string name="library_empty">No surahs match.</string>
    <string name="library_retry">Try again</string>
    <string name="library_search_placeholder">Search surahs</string>
    <string name="library_filter_all">All</string>
    <string name="library_filter_mecca">Mecca</string>
    <string name="library_filter_medina">Medina</string>
    <string name="library_filter_short">Short</string>
</resources>
