<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted only for localhost and 10.0.2.2 (the Android
  emulator's alias for the host machine's localhost). All other hosts
  must use HTTPS. Production traffic targets the BFF over TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
