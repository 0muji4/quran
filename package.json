{
  "name": "quran-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "globals": "^15.15.0"
  },
  "scripts": {
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r lint && pnpm run lint:e2e",
    "lint:e2e": "eslint e2e",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:go": "go test ./apps/backend/... ./apps/worker/go/... ./packages/go-pkg/...",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test e2e/tests/visual/",
    "test:e2e:visual:update": "playwright test e2e/tests/visual/ --update-snapshots",
    "build": "pnpm -r --if-present build",
    "gen:quran-seed": "tsx scripts/generate-quran-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@quran-project/eslint-config": "workspace:*",
    "eslint": "^9.39.4",
    "tsx": "^4.22.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "lodash": "^4.18.1",
      "postcss": "^8.5.10",
      "vite": "^6.4.2"
    }
  }
}
