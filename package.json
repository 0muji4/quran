{
  "name": "quran-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "globals": "^17.14.0"
  },
  "scripts": {
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r lint && pnpm run lint:e2e",
    "lint:e2e": "eslint e2e",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:go": "go test ./apps/backend/... ./packages/go-pkg/...",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test e2e/tests/visual/",
    "test:e2e:visual:update": "playwright test e2e/tests/visual/ --update-snapshots",
    "build": "pnpm -r --if-present build",
    "gen:quran-seed": "tsx scripts/generate-quran-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@bufbuild/buf": "^1.75.0",
    "@playwright/test": "^1.60.0",
    "@quran-project/eslint-config": "workspace:*",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15"
  }
}
